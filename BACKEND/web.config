<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers accessPolicy="Read, Execute, Script">
      <add name="FastAPIHttpPlatformHandler" 
           path="*" 
           verb="*" 
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <!-- Update the processPath to match your Python installation -->
    <httpPlatform processPath="C:\Z_ASHIK_MAHMUD\FASTAPI_TO_IIS\iis\Scripts\python.exe"
                  arguments="-m uvicorn --host 0.0.0.0 --port %HTTP_PLATFORM_PORT% main:app"
                  stdoutLogEnabled="true" 
                  stdoutLogFile="C:\Z_ASHIK_MAHMUD\FASTAPI_TO_IIS\log" 
                  startupTimeLimit="120" 
                  requestTimeout="00:05:00"
                  startupRetryCount="3">

      <!-- Environment variables if needed -->
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\Z_ASHIK_MAHMUD\FASTAPI_TO_IIS"/>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>

    <!-- Enable detailed error messages during development -->
    <httpErrors errorMode="Detailed" />

    <!-- Optional: Configure default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="main.py" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>