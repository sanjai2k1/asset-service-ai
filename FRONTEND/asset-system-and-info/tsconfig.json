{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "rootDir": "src",         // TS source folder
    "outDir": "dist",         // compiled JS goes outside src
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client","node"]
  },
  "include": ["src"]
}